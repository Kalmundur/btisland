# Supabase project settings (Project Settings -> API).
# Only the PUBLIC anon key belongs here. Never put the service-role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: public web address used for links shared from the iOS/Android apps.
# VITE_PUBLIC_URL=https://btisland.vercel.app
